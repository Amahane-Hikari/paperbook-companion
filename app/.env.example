# 复制为 .env 后填写；不要提交真实密钥。
# 留空的能力会在工作台标记为未配置，不会伪造生成结果。
TARGET_DIR=

# 文本写作与问答：完整的 OpenAI-compatible chat/completions URL
SIMPLE_STORY_WRITER_URL=
SIMPLE_STORY_WRITER_API_KEY=
SIMPLE_STORY_WRITER_MODEL=
NLU_URL=
NLU_API_KEY=
NLU_MODEL=

# 必须是支持图片输入的视觉模型；文本端点不能替代 OCR/VL。
IMAGE_ANALYSIS_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# 保留原有火山方舟视频适配，填实际可用模型。
IMAGE2VIDEO_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE2VIDEO_API_KEY=
IMAGE2VIDEO_MODEL=

# 可选文生图、音乐与音效；PDF 可直接使用原页图。
TEXT2IMAGE_URL=
TEXT2IMAGE_API_KEY=
TEXT2IMAGE_MODEL=
TEXT2MUSIC_URL=
TEXT2MUSIC_API_KEY=
TEXT2MUSIC_MODEL=
TEXT2AUDIO_URL=
TEXT2AUDIO_API_KEY=
TEXT2AUDIO_MODEL=

# 默认不自动下载模型，配置本地目录后启用识别。
WHISPER_MODEL=models/faster-whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=zh
WHISPER_ALLOW_DOWNLOAD=false

# 找不到 PATH 工具时填写本机 FFmpeg/ffprobe 可执行文件绝对路径。
FFMPEG_PATH=
FFPROBE_PATH=
BOOK_VIDEO_WIDTH=1280
BOOK_VIDEO_HEIGHT=720
BOOK_VIDEO_FPS=24
BOOK_MAX_PAGES=100
BOOK_MAX_UPLOAD_BYTES=134217728
